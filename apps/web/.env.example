# Township FloodOps Web Environment Configuration

# Data Mode: 'mock' or 'api'
# In 'mock' mode, UI uses local synthetic fixtures matching the v1 contract.
# In 'api' mode, UI makes real HTTP calls to the backend API.
# Note: Real API failure will NEVER automatically fallback to mock.
VITE_DATA_MODE=mock

# Base URL of the FloodOps FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
